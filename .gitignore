__pycache__/
*.pyc

# Secrets — never commit (use Colab Secrets for GROQ_API_KEY)
.env

# Work / output media — jobs run on copies in Colab, deliverables are new files
*.mp4
*.mov
*.mkv
*.m4v
*.webm
*.wav
*.mp3

